{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "favorites": {
      "title": "User Favorites",
      "description": "Saved favorite players and personal scout notes for each user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "playerId": { "type": "string" },
        "notes": { "type": "string" },
        "tier": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "playerId"]
    },
    "comments": {
      "title": "Player Comments",
      "description": "Fan discussions and analysis for transfer portal recruits",
      "type": "object",
      "properties": {
        "playerId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["playerId", "userId", "text"]
    }
  }
}
